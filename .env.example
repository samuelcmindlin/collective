# Copy to .env. Secrets are never sent to the browser or agent processes.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to approve requests and change missions.
DISCORD_OPERATOR_IDS=
# Optional, scoped to the repositories the collective is allowed to use.
GITHUB_TOKEN=
GITHUB_OWNER=
# Local application configuration
COLLECTIVE_PORT=4310
COLLECTIVE_DATA_DIR=.collective
CLAUDE_BIN=claude
